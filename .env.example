# Copy to .env, generate a unique secret, and never commit .env.
SENTINELFORGE_API_KEY=replace_with_a_random_32_byte_token
# Preferred rotating credentials (set CURRENT, overlap with PREVIOUS briefly, then remove PREVIOUS).
SENTINELFORGE_API_KEY_CURRENT=
SENTINELFORGE_API_KEY_PREVIOUS=
SENTINELFORGE_PROTECT_READS=true
SENTINELFORGE_DB=/data/sentinelforge.sqlite3
SENTINELFORGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SENTINELFORGE_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SENTINELFORGE_ENABLE_DOCS=false
